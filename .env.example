# ==========================================
# Server Hosting & Networking
# ==========================================
PORT=3000
APP_URL="http://localhost:3000"

# Optional direct HTTPS / SSL (if not using an Nginx/Caddy reverse proxy on your VM)
# SSL_KEY_PATH="/path/to/server.key"
# SSL_CERT_PATH="/path/to/server.crt"

# ==========================================
# Data Storage & Database
# ==========================================
# Primary application data is stored in a relational SQL database.
# Configure connection parameters directly in the UI under Master Data, or pre-configure via data/db-config.json.
# Supported engines:
#   - SQLite (Default embedded local DB): data/quintiq.db
#   - PostgreSQL (Enterprise remote/cloud DB): host, port, database, username, password, sslMode
#   - SQL Server (Microsoft SQL Server / Azure SQL): host, port (1433), database, username, password, trustServerCertificate
#
# Tables automatically managed:
#   - projects
#   - weekly_updates
#   - settings
